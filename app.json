{
  "expo": {
    "name": "Scuttle",
    "slug": "scuttle",
    "scheme": "scuttle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.scuttle.app" },
    "android": { "package": "com.scuttle.app", "adaptiveIcon": { "backgroundColor": "#ffffff" } }
  }
}
